GOOGLE_API_KEY=your_gemini_api_key_here
ANALYSIS_MODE=auto

# Optional recruiter feedback delivery. Keep false on an unauthenticated server.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Matchline hiring team
# starttls, ssl, or plain
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=15
