GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
ANALYSIS_MODE=auto
GEMINI_LLM_MODEL=gemini-2.5-flash
OPENAI_LLM_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional recruiter feedback delivery. Keep false on an unauthenticated server.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=OpenMatch hiring team
# starttls, ssl, or plain
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=15
